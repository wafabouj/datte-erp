// Mini ERP dattes — schéma de données
// Source de vérité unique pour Référentiels, Commandes, Facturation, Stock, Production

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =========================================================================
// AUTH
// =========================================================================

enum UserRole {
  ADMIN
  COMMERCIAL
  PRODUCTION
  COMPTABILITE
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         UserRole @default(ADMIN)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  salesOrders      SalesOrder[]
  invoices         Invoice[]
  stockMovements   StockMovement[]
  productionOrders ProductionOrder[]
}

// =========================================================================
// REFERENTIELS
// =========================================================================

model Currency {
  code           String  @id // ISO 4217: EUR, USD, TND...
  name           String
  symbol         String
  isBaseCurrency Boolean @default(false)

  exchangeRates ExchangeRate[]
  clients       Client[]
  articles      Article[]
  salesOrders   SalesOrder[]
  invoices      Invoice[]
}

model ExchangeRate {
  id           String   @id @default(cuid())
  currencyCode String
  currency     Currency @relation(fields: [currencyCode], references: [code])
  rateToBase   Decimal  @db.Decimal(18, 6) // 1 unité devise = rateToBase unités devise de base
  date         DateTime @default(now())

  @@index([currencyCode, date])
}

model UnitOfMeasure {
  id   String @id @default(cuid())
  code String @unique // KG, CARTON5, CARTON10, PALETTE...
  name String

  articles        Article[]
  conversionsFrom UomConversion[] @relation("FromUom")
  conversionsTo   UomConversion[] @relation("ToUom")
}

// 1 fromUom = factor * toUom  (ex: 1 CARTON5 = 5 KG => factor = 5)
model UomConversion {
  id        String        @id @default(cuid())
  fromUomId String
  fromUom   UnitOfMeasure @relation("FromUom", fields: [fromUomId], references: [id])
  toUomId   String
  toUom     UnitOfMeasure @relation("ToUom", fields: [toUomId], references: [id])
  factor    Decimal       @db.Decimal(18, 6)

  @@unique([fromUomId, toUomId])
}

model Client {
  id               String   @id @default(cuid())
  code             String   @unique
  name             String
  country          String
  address          String?
  contactName      String?
  contactEmail     String?
  contactPhone     String?
  paymentTermsDays Int      @default(30)
  currencyCode     String
  currency         Currency @relation(fields: [currencyCode], references: [code])
  defaultIncoterm  String? // FOB, CIF, EXW...
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())

  salesOrders SalesOrder[]
  invoices    Invoice[]
}

model Supplier {
  id           String   @id @default(cuid())
  code         String   @unique
  name         String
  country      String
  address      String?
  contactName  String?
  contactEmail String?
  contactPhone String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  lots Lot[]
}

model Warehouse {
  id        String  @id @default(cuid())
  code      String  @unique
  name      String
  address   String?
  isDefault Boolean @default(false)

  stockLevels      StockLevel[]
  stockMovements   StockMovement[]
  salesOrderLines  SalesOrderLine[]
  productionOrders ProductionOrder[]
}

enum ArticleType {
  RAW_MATERIAL // dattes brutes avant tri/conditionnement
  PACKAGING // emballages, cartons
  FINISHED_PRODUCT // produit fini vendable
}

model Article {
  id           String        @id @default(cuid())
  code         String        @unique
  name         String
  type         ArticleType
  variety      String? // Deglet Nour, Mejhoul...
  caliber      String? // calibre
  packaging    String? // "Carton 5kg", "Vrac", ...
  uomId        String
  uom          UnitOfMeasure @relation(fields: [uomId], references: [id])
  minStock     Decimal       @default(0) @db.Decimal(18, 3)
  unitCost     Decimal       @default(0) @db.Decimal(18, 4)
  unitPrice    Decimal       @default(0) @db.Decimal(18, 4)
  currencyCode String
  currency     Currency      @relation(fields: [currencyCode], references: [code])
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())

  stockLevels      StockLevel[]
  stockMovements   StockMovement[]
  lots             Lot[]
  salesOrderLines  SalesOrderLine[]
  invoiceLines     InvoiceLine[]
  bomAsFinished    BillOfMaterial[]        @relation("BomFinishedArticle")
  bomComponentOf   BomComponent[]
  productionOrders ProductionOrder[]
  consumptions     ProductionConsumption[]
  outputs          ProductionOutput[]
}

// =========================================================================
// STOCK & TRAÇABILITÉ
// =========================================================================

// Numéro de lot : traçabilité amont (fournisseur/récolte) et aval (production)
model Lot {
  id                String           @id @default(cuid())
  code              String           @unique
  articleId         String
  article           Article          @relation(fields: [articleId], references: [id])
  supplierId        String?
  supplier          Supplier?        @relation(fields: [supplierId], references: [id])
  harvestDate       DateTime?
  receptionDate     DateTime?
  productionOrderId String? // si le lot est issu d'une production
  productionOrder   ProductionOrder? @relation("OutputLot", fields: [productionOrderId], references: [id])
  expiryDate        DateTime?
  createdAt         DateTime         @default(now())

  stockLevels    StockLevel[]
  stockMovements StockMovement[]
  consumptions   ProductionConsumption[]
  outputs        ProductionOutput[]
}

// Solde de stock maintenu (dérivé du ledger StockMovement) pour lecture rapide
model StockLevel {
  id          String    @id @default(cuid())
  articleId   String
  article     Article   @relation(fields: [articleId], references: [id])
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])
  lotId       String?
  lot         Lot?      @relation(fields: [lotId], references: [id])
  quantity    Decimal   @default(0) @db.Decimal(18, 3)
  updatedAt   DateTime  @updatedAt

  @@unique([articleId, warehouseId, lotId])
}

enum StockMovementType {
  RECEPTION // réception matière première / emballage
  SALE_SHIPMENT // expédition suite commande client
  PRODUCTION_CONSUMPTION // consommation MP/emballage par un OF
  PRODUCTION_OUTPUT // entrée en stock du produit fini d'un OF
  ADJUSTMENT // correction manuelle d'inventaire
  TRANSFER_OUT
  TRANSFER_IN
}

// Ledger immuable de tous les mouvements de stock = source de traçabilité
model StockMovement {
  id            String            @id @default(cuid())
  articleId     String
  article       Article           @relation(fields: [articleId], references: [id])
  warehouseId   String
  warehouse     Warehouse         @relation(fields: [warehouseId], references: [id])
  lotId         String?
  lot           Lot?              @relation(fields: [lotId], references: [id])
  quantity      Decimal           @db.Decimal(18, 3) // positif = entrée, négatif = sortie
  type          StockMovementType
  referenceType String? // "SalesOrder", "ProductionOrder", ...
  referenceId   String?
  notes         String?
  date          DateTime          @default(now())
  createdById   String?
  createdBy     User?             @relation(fields: [createdById], references: [id])

  @@index([articleId, warehouseId])
  @@index([referenceType, referenceId])
}

// =========================================================================
// COMMANDES (VENTES)
// =========================================================================

enum SalesOrderStatus {
  DRAFT
  CONFIRMED
  IN_PREPARATION
  SHIPPED
  DELIVERED
  CLOSED
  CANCELLED
}

model SalesOrder {
  id                    String           @id @default(cuid())
  number                String           @unique
  clientId              String
  client                Client           @relation(fields: [clientId], references: [id])
  status                SalesOrderStatus @default(DRAFT)
  currencyCode          String
  currency              Currency         @relation(fields: [currencyCode], references: [code])
  incoterm              String? // FOB, CIF, EXW...
  orderDate             DateTime         @default(now())
  requestedDeliveryDate DateTime?
  shippedDate           DateTime?
  deliveredDate         DateTime?
  notes                 String?
  createdById           String?
  createdBy             User?            @relation(fields: [createdById], references: [id])
  createdAt             DateTime         @default(now())

  lines    SalesOrderLine[]
  invoices Invoice[]

  @@index([clientId])
}

model SalesOrderLine {
  id          String     @id @default(cuid())
  orderId     String
  order       SalesOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  articleId   String
  article     Article    @relation(fields: [articleId], references: [id])
  warehouseId String?
  warehouse   Warehouse? @relation(fields: [warehouseId], references: [id])
  quantity    Decimal    @db.Decimal(18, 3)
  unitPrice   Decimal    @db.Decimal(18, 4)
  lineTotal   Decimal    @db.Decimal(18, 2)

  invoiceLines InvoiceLine[]
}

// =========================================================================
// FACTURATION
// =========================================================================

enum InvoiceType {
  INVOICE
  CREDIT_NOTE
}

enum InvoiceStatus {
  ISSUED
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

model Invoice {
  id           String        @id @default(cuid())
  number       String        @unique
  type         InvoiceType   @default(INVOICE)
  status       InvoiceStatus @default(ISSUED)
  clientId     String
  client       Client        @relation(fields: [clientId], references: [id])
  salesOrderId String?
  salesOrder   SalesOrder?   @relation(fields: [salesOrderId], references: [id])
  currencyCode String
  currency     Currency      @relation(fields: [currencyCode], references: [code])
  issueDate    DateTime      @default(now())
  dueDate      DateTime
  totalAmount  Decimal       @db.Decimal(18, 2)
  notes        String?
  createdById  String?
  createdBy    User?         @relation(fields: [createdById], references: [id])
  createdAt    DateTime      @default(now())

  lines    InvoiceLine[]
  payments Payment[]

  @@index([clientId])
}

model InvoiceLine {
  id               String          @id @default(cuid())
  invoiceId        String
  invoice          Invoice         @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  salesOrderLineId String?
  salesOrderLine   SalesOrderLine? @relation(fields: [salesOrderLineId], references: [id])
  articleId        String
  article          Article         @relation(fields: [articleId], references: [id])
  description      String?
  quantity         Decimal         @db.Decimal(18, 3)
  unitPrice        Decimal         @db.Decimal(18, 4)
  lineTotal        Decimal         @db.Decimal(18, 2)
}

model Payment {
  id        String   @id @default(cuid())
  invoiceId String
  invoice   Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  amount    Decimal  @db.Decimal(18, 2)
  date      DateTime @default(now())
  method    String? // virement, chèque, LC...
  reference String?
  createdAt DateTime @default(now())
}

// =========================================================================
// PRODUCTION — NOMENCLATURES (BOM)
// =========================================================================

// Nomenclature d'un produit fini : matière première + composants (emballage) requis par unité
model BillOfMaterial {
  id                String  @id @default(cuid())
  finishedArticleId String
  finishedArticle   Article @relation("BomFinishedArticle", fields: [finishedArticleId], references: [id])
  name              String
  expectedYieldPct  Decimal @default(100) @db.Decimal(5, 2) // rendement attendu (pertes tri/calibrage)
  isActive          Boolean @default(true)

  components       BomComponent[]
  productionOrders ProductionOrder[]

  @@index([finishedArticleId])
}

model BomComponent {
  id         String         @id @default(cuid())
  bomId      String
  bom        BillOfMaterial @relation(fields: [bomId], references: [id], onDelete: Cascade)
  articleId  String // matière première ou emballage
  article    Article        @relation(fields: [articleId], references: [id])
  qtyPerUnit Decimal        @db.Decimal(18, 4) // quantité nécessaire par unité de produit fini

  @@unique([bomId, articleId])
}

// =========================================================================
// PRODUCTION — PLANIFICATION & CAPACITÉ
// =========================================================================

model WorkCenter {
  id                         String  @id @default(cuid())
  code                       String  @unique
  name                       String // ex: Ligne de tri, Ligne de calibrage, Ligne d'emballage
  capacityKgPerHourPerWorker Decimal @db.Decimal(10, 2)
  workingHoursPerDay         Decimal @default(8) @db.Decimal(5, 2)
  workingDays                Int[]   @default([1, 2, 3, 4, 5]) // 0=dimanche .. 6=samedi
  breakMinutesPerDay         Int     @default(30)
  isActive                   Boolean @default(true)

  workers          Worker[]
  productionOrders ProductionOrder[]
}

model Worker {
  id                  String      @id @default(cuid())
  name                String
  defaultWorkCenterId String?
  defaultWorkCenter   WorkCenter? @relation(fields: [defaultWorkCenterId], references: [id])
  yieldKgPerHour      Decimal?    @db.Decimal(10, 2) // rendement individuel si différent de la moyenne du poste
  isActive            Boolean     @default(true)

  assignments ProductionOrderWorker[]
}

enum ProductionOrderStatus {
  DRAFT
  PLANNED
  IN_PROGRESS
  DONE
  CANCELLED
}

model ProductionOrder {
  id               String                @id @default(cuid())
  number           String                @unique
  bomId            String
  bom              BillOfMaterial        @relation(fields: [bomId], references: [id])
  status           ProductionOrderStatus @default(DRAFT)
  quantityPlanned  Decimal               @db.Decimal(18, 3) // quantité de produit fini visée (unités du produit fini)
  quantityProduced Decimal               @default(0) @db.Decimal(18, 3)

  workCenterId String?
  workCenter   WorkCenter? @relation(fields: [workCenterId], references: [id])
  workerCount  Int?        @default(1) // effectif affecté à cet OF

  warehouseId String? // entrepôt de sortie MP / entrée PF
  warehouse   Warehouse? @relation(fields: [warehouseId], references: [id])

  plannedStartDate DateTime?
  plannedEndDate   DateTime? // calculé à partir de la capacité
  actualStartDate  DateTime?
  actualEndDate    DateTime?

  notes       String?
  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  outputLots   Lot[]                   @relation("OutputLot")
  workers      ProductionOrderWorker[]
  consumptions ProductionConsumption[]
  outputs      ProductionOutput[]
  Article      Article?                @relation(fields: [articleId], references: [id])
  articleId    String?

  @@index([workCenterId, plannedStartDate])
}

model ProductionOrderWorker {
  id                String          @id @default(cuid())
  productionOrderId String
  productionOrder   ProductionOrder @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)
  workerId          String
  worker            Worker          @relation(fields: [workerId], references: [id])

  @@unique([productionOrderId, workerId])
}

// Consommation réelle de MP/emballage à la validation de l'OF (traçabilité lot amont)
model ProductionConsumption {
  id                String          @id @default(cuid())
  productionOrderId String
  productionOrder   ProductionOrder @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)
  articleId         String
  article           Article         @relation(fields: [articleId], references: [id])
  lotId             String?
  lot               Lot?            @relation(fields: [lotId], references: [id])
  quantity          Decimal         @db.Decimal(18, 3)
  createdAt         DateTime        @default(now())
}

// Entrée en stock du produit fini à la clôture de l'OF (traçabilité lot aval)
model ProductionOutput {
  id                String          @id @default(cuid())
  productionOrderId String
  productionOrder   ProductionOrder @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)
  articleId         String
  article           Article         @relation(fields: [articleId], references: [id])
  lotId             String
  lot               Lot             @relation(fields: [lotId], references: [id])
  quantity          Decimal         @db.Decimal(18, 3)
  createdAt         DateTime        @default(now())
}
